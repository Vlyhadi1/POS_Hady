# Copy these names into Vercel -> Settings -> Environment Variables.
# Never commit a real APP_KEY or database password.

APP_NAME=POS Hady
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pos-hady.vercel.app
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate_--show

# Vercel containers are stateless, so use array session/cache unless you have
# a managed cache service. The database remains external/persistent.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Use a managed MySQL/MariaDB database. Do NOT use 127.0.0.1 here.
DB_CONNECTION=mysql
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional mail settings for real password-reset emails.
MAIL_MAILER=log
